# SQLite file by default (zero setup, works out of the box). If you outgrow
# it, swap src/db.ts for a Postgres-backed implementation of the same
# interface — see README "Scaling the database".
DATABASE_PATH="./dev.db"

# Server
PORT=8787

# Set to "production" on a real deployment (not needed locally) — the
# /attribution portal's login cookie only gets the Secure flag when this
# is set, since Secure cookies require HTTPS and localhost dev usually
# isn't. See server/src/lib/auth.ts.
# NODE_ENV=production

# The public URL clients reach this server at (no trailing slash). Used
# to build the exact tracking snippet / API URL shown on each tenant's
# dashboard under "Install tracking". If unset, it's inferred from the
# incoming request's protocol + Host header (fine behind a well-behaved
# reverse proxy with `trust proxy` on, which index.ts sets), but setting
# this explicitly is more reliable in production — no dependency on
# Caddy/nginx forwarding headers correctly.
# PUBLIC_BASE_URL=https://attribution.automated-sales.co

# That's it for global config. Per-client settings — Pipedrive API token,
# company domain, webhook secret, tracking snippet key — live in the
# `tenants` table, not here, because this one server serves many client
# businesses. Create a client with:
#   npm run add-tenant -- --slug acme-co --name "Acme Co" --pipedrive-token <token> --pipedrive-domain acme-co
# See README "Onboarding a new client" for the full flow.
