# Dependencies — reinstalled from package-lock.json, never committed.
node_modules/

# Build output — regenerated by `npm run build` on deploy.
dist/
build/
*.tsbuildinfo

# Secrets — real API tokens, webhook secrets, session secrets. Only
# .env.example (a template with no real values) is committed.
.env
.env.local
.env.*.local

# Local/dev database — holds real tenant + prospect data on the droplet,
# and leftover test fixtures locally. Never belongs in source control.
*.sqlite
*.sqlite3
*.db

# Deploy artifact — rebuilt fresh from source for every deploy, not
# something to version.
journeytracker.zip
*.zip

# OS/editor cruft.
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*
